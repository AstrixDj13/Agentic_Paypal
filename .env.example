# Copy this file to .env and fill it in. Never commit .env.

# --- Main sandbox REST app (owned by the DEMO STORE business account) ---
# developer.paypal.com > Apps & Credentials > Sandbox > your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Second sandbox REST app (owned by the AGENT COVER POOL business account) ---
# Used for agent-at-fault payouts. Leave blank for now; the spike falls back to the main app.
COVER_POOL_CLIENT_ID=
COVER_POOL_CLIENT_SECRET=

# --- Sandbox PERSONAL (buyer) account email, receives payouts ---
SANDBOX_BUYER_EMAIL=

# Local port for PayPal return URLs during the spike
PORT=8787
